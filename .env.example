# Copy to .env (never commit .env):  cp .env.example .env

# --- Self-check -----------------------------------------------------------
# Your trainee ID, given by your trainer. Stamped on self_check_report.json.
SELF_CHECK_KEY=trainee-your-name

# --- LLM (milestone 1) -----------------------------------------------------
# anthropic -> uv add langchain-anthropic   |   openai -> uv add langchain-openai
LLM_PROVIDER=google
LLM_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- LangSmith observability (milestone 2) ---------------------------------
# Create a key at https://smith.langchain.com -> Settings -> API Keys.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-chatbot-your-name
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Chunking (milestone 3) ------------------------------------------------
# Name of a strategy you registered in app/vectordb/chunking.py
CHUNKING_STRATEGY=fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Embeddings (milestone 4) ----------------------------------------------
EMBEDDING_MODEL=

# --- Retrieval (milestone 7) -----------------------------------------------
TOP_K=4

# --- Data folders (optional; defaults are under ./data) ---------------------
# DATA_DIR=./data
# SESSIONS_DIR=./data/sessions
# DOCUMENTS_DIR=./data/documents
# VECTOR_DIR=./data/vectorstore

# --- Retrieval mode + router ---
RETRIEVAL_MODE=hybrid
ROUTER_LLM_PICKER=true

# --- Infrastructure (docker compose up -d) ----------------------------------
# Postgres (with pgvector) holds users, chat history and the vector index.
DATABASE_URL=postgresql://rag:rag@127.0.0.1:5434/rag_chatbot
# Redis holds login sessions, e-mail codes, reset tokens and rate limits.
REDIS_URL=redis://127.0.0.1:6380/0
# auto (pgvector when DATABASE_URL is set) | pgvector | json (the old data/vectorstore/store.json)
VECTOR_BACKEND=auto

# --- Accounts + e-mail (Brevo, https://app.brevo.com -> SMTP & API -> API keys) ---
# Without a key, e-mails are printed to the server log instead (codes still work locally).
BREVO_API_KEY=
# A sender address verified in Brevo. Leave empty to use the account's first verified sender.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RAG Chatbot
# Used in password-reset links.
APP_BASE_URL=http://127.0.0.1:8000
SESSION_TTL_DAYS=14
